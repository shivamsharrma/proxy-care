# Local development settings. Copy to .env (git-ignored): `make env`.
# Read by docker/compose.yaml (via make) and by the `local` Spring profile.
# Never put staging or production credentials here: deployed environments get them
# from the hosting platform's secret store as environment variables.

# Local PostGIS container (docker/compose.yaml). Local-only values.
PROXYCARE_DB_URL=jdbc:postgresql://localhost:5432/proxycare
# The application connects as proxycare_app (data access only, docs/DATABASE.md).
PROXYCARE_DB_USERNAME=proxycare_app
PROXYCARE_DB_PASSWORD=change-me-local-app
# Flyway connects as the schema owner when the local profile migrates at start-up.
PROXYCARE_DB_MIGRATOR_USERNAME=proxycare_migrator
PROXYCARE_DB_MIGRATOR_PASSWORD=change-me-local-migrator
# Container superuser (administration only).
PROXYCARE_DB_ADMIN_PASSWORD=change-me-local-admin

# Staging and production read (set by the platform, not in this file):
#   SPRING_PROFILES_ACTIVE=staging|prod
#   PROXYCARE_DB_URL       jdbc:postgresql://<host>:5432/<db>?sslmode=verify-full&sslrootcert=<path>
#                          direct connection, or the session-mode pooler (never port 6543)
#   PROXYCARE_DB_USERNAME  proxycare_app
#   PROXYCARE_DB_PASSWORD
#   PROXYCARE_MANAGEMENT_PORT  optional, default 8081
# Migrations run as a separate step with proxycare_migrator (docs/DATABASE.md).
