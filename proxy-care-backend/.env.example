# Copy to .env and fill in. Never commit .env.
# Loaded by the `local` profile. Format is Java .properties: no quotes; write a backslash in a value as \\.

# Postgres: Supabase's session pooler, as the dedicated backend role (never the service-role key).
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USER=
DB_PASSWORD=

# Supabase project URL, e.g. https://<project-ref>.supabase.co. The project must sign tokens with ES256 or RS256.
SUPABASE_URL=

# Razorpay API key: required (RazorpayX penny drop uses it; payments will too).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# RazorpayX penny drop (C5 payout account). Required. Live mode only: RazorpayX has no test mode for validations.
# Our RazorpayX business account number the Rs 1 is sent from.
RAZORPAYX_ACCOUNT_NUMBER=
# The secret set on the RazorpayX webhook for fund_account.validation.completed / .failed.
RAZORPAYX_WEBHOOK_SECRET=
# Lowest name_match_score that counts as a match. Placeholder 70: the score's range is unconfirmed (README).
RAZORPAYX_NAME_MATCH_THRESHOLD=70

# Required. Base64 of 32 random bytes, a different key per environment, e.g. `openssl rand -base64 32`.
# Encrypts bank account numbers at rest; losing it makes stored numbers unreadable.
BANK_ACCOUNT_ENCRYPTION_KEY=

# Optional until their features are built.
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
