# Copy to .env and fill in. Never commit .env.
# Loaded by the `local` profile. Format is Java .properties: no quotes; write a backslash in a value as \\.

# Postgres: Supabase's session pooler, as the dedicated backend role (never the service-role key).
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USER=
DB_PASSWORD=

# Supabase project URL, e.g. https://<project-ref>.supabase.co. The project must sign tokens with ES256 or RS256.
SUPABASE_URL=

# Optional until their features are built.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
