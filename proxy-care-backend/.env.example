# Copy to .env and fill in. Never commit .env.
SPRING_PROFILES_ACTIVE=local

# Postgres credentials for the dedicated backend DB role (NOT the Supabase service-role key).
DB_URL=jdbc:postgresql://localhost:5432/proxycare
DB_USER=proxycare
DB_PASSWORD=change-me

# Supabase project URL, e.g. https://<ref>.supabase.co (required from M4).
SUPABASE_URL=
# Optional: legacy HS256 JWT secret. When set, HS256 is used instead of JWKS.
SUPABASE_JWT_SECRET=

# Razorpay (webhook secret required from M6; keys optional until payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional until their features are built.
GOOGLE_MAPS_API_KEY=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
